{
	"name": "@ertdfgcvb/play",
	"version": "2.0.0-alpha.1",
	"description": "ASCII Playground core: run programs that output text grids, in the browser or headless in Node",
	"keywords": [
		"ascii",
		"ascii-art",
		"asciiart",
		"ansi",
		"textmode",
		"text-mode",
		"creative-coding",
		"generative",
		"live-coding",
		"realtime",
		"shader",
		"glsl",
		"demoscene",
		"grid",
		"terminal",
		"canvas"
	],
	"type": "module",
	"exports": {
		".": "./src/run.js",
		"./renderers/*": "./src/renderers/*",
		"./*": "./src/modules/*"
	},
	"files": [
		"src/run.js",
		"src/core",
		"src/renderers",
		"src/modules"
	],
	"scripts": {
		"test": "node --test test/*.test.js",
		"list": "node tools/directory.js"
	},
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ertdfgcvb/play.core.git"
	},
	"homepage": "https://play.ertdfgcvb.xyz",
	"license": "Apache-2.0",
	"author": "Andreas Gysin",
	"publishConfig": {
		"access": "public"
	}
}
